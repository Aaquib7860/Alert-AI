# Copy to .env and fill in real values. Never commit .env.

# Data
RAW_DATA_PATH=data/raw/Alerts_Samples.xlsx
DATASET_VERSION=v1

# Database (production; not required for notebook PoC)
DATABASE_URL=

# Model registry root -- contains entity/, transaction/, registry/ subdirs.
# Which specific model version is "active" per alert type is NOT set here --
# it's controlled by models/registry/active_models.json (written by
# scripts/build_scoring_registry.py), so promoting/rolling back a model
# never requires redeploying application code.
MODEL_REGISTRY_PATH=models

# API
API_HOST=0.0.0.0
API_PORT=8000

# PoC placeholder only -- NOT a calibrated/approved production threshold
# (master plan section 13/15). Global novelty percentile (0-100) at or
# above this value maps to a REVIEW recommendation.
REVIEW_PERCENTILE_THRESHOLD=80

# Feedback capture (Phase 8 minimal capture only; full validation pipeline
# is Phase 12)
FEEDBACK_STORE_PATH=feedback/feedback_log.jsonl

# Redis (optional, only if caching is needed)
REDIS_URL=
